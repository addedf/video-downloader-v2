<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.zemin.downloader.ui.view.CenteredVideoView
        android:id="@+id/playerSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <ProgressBar
        android:id="@+id/playerLoading"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/dy_cyan"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playerStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_status"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/playerControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_controls"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/playerCenterControls"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="invisible">

            <FrameLayout
                android:id="@+id/btnPlayerRewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_button"
                android:clickable="true"
                android:contentDescription="@string/player_rewind_5"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_player_replay"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/player_rewind_seconds"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnPlayerPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_player_play_button"
                android:contentDescription="@string/player_play"
                android:padding="16dp"
                android:src="@drawable/ic_player_play"
                app:tint="@color/dy_primary" />

            <FrameLayout
                android:id="@+id/btnPlayerForward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_control_button"
                android:clickable="true"
                android:contentDescription="@string/player_forward_15"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleX="-1"
                    android:src="@drawable/ic_player_replay"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/player_forward_seconds"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B8050507"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="5dp">

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:contentDescription="@string/player_seek"
                android:max="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/dy_cyan"
                android:splitTrack="false"
                android:thumbTint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayerTime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/player_time_initial"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPlayerSpeed"
                    android:layout_width="52dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_player_speed_button"
                    android:clickable="true"
                    android:contentDescription="@string/player_speed_normal"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/player_speed_initial"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnPlayerMute"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_player_control_button"
                    android:contentDescription="@string/player_mute"
                    android:padding="10dp"
                    android:src="@drawable/ic_player_volume_on"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btnPlayerFullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_player_control_button"
                    android:contentDescription="@string/player_enter_fullscreen"
                    android:padding="10dp"
                    android:src="@drawable/ic_player_fullscreen"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</merge>
